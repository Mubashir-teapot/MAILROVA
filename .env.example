# Copy this to `.env` and fill in real values.
# Single root env file — consumed by docker-compose.yml (variable substitution)
# and injected into containers via `env_file: .env` per service.

# ---- Postgres ----
POSTGRES_USER=mailrova
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mailrova
DATABASE_URL=postgresql://mailrova:change_me@db:5432/mailrova?schema=public

# ---- Backend ----
NODE_ENV=development
# Internal listen port only — the backend is never exposed to the internet
# directly (no host port, no Dokploy Domain). The frontend's Next.js server
# proxies /api/* to it over the internal Docker network (see
# frontend/next.config.js). Only change this if you also update the
# `expose:`/BACKEND_INTERNAL_URL wiring in docker-compose.yml to match.
BACKEND_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
UPLOAD_DIR=/app/uploads
# The PUBLIC, internet-reachable URL — this is the frontend's domain, NOT
# the backend's (the backend has no domain of its own). Used to build links
# that must work when clicked from outside any browser session, e.g. an
# unsubscribe link in an email: https://app.yourdomain.com/api/public/...
# which the frontend then proxies to the backend internally.
PUBLIC_URL=http://localhost:5173
CAMPAIGN_SCHEDULER_INTERVAL_MS=30000
SEND_RATE_PER_MINUTE=60
# Kept as a fallback safety net for anything that calls the backend
# directly instead of through the frontend's proxy (e.g. local debugging
# with docker-compose.override.yml). Not used in a normal Dokploy deploy,
# since the browser only ever talks to the frontend.
CORS_ORIGINS=http://localhost:5173

# ---- Platform admin (manages tenants — separate login from any tenant's own users) ----
PLATFORM_ADMIN_USERNAME=platform-admin
# Leave blank to auto-generate one on first run (printed once to the backend
# container's logs — check `docker compose logs backend` after first boot).
PLATFORM_ADMIN_PASSWORD=

# ---- First tenant, auto-created on first run if none exist yet ----
# Add more tenants later via the platform admin UI.
DEFAULT_TENANT_NAME=My Organization
DEFAULT_TENANT_SLUG=default
# The hostname this tenant is reachable on — must match what you type in the
# browser. Use "localhost" for local dev; your real domain in production.
DEFAULT_TENANT_HOSTNAME=localhost
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
# Leave blank to auto-generate (printed once to the backend logs).
ADMIN_PASSWORD=

# ---- Frontend ----
# Internal listen port (matches the -p in frontend/package.json's dev/start
# scripts) — only used for the `expose:` line in docker-compose.yml.
FRONTEND_PORT=5173
# Relative on purpose: the browser calls this frontend's own /api/*, which
# next.config.js proxies to the backend server-side. Only set this to an
# absolute URL if you're running the frontend and backend as genuinely
# separate public domains instead (not the default setup).
NEXT_PUBLIC_API_URL=/api

# ---- SMTP ----
# MAIL_MODE picks how mail actually gets sent — this is the one switch:
#   self_hosted  -> always goes through the `mta` container below. SMTP_HOST/
#                   PORT/USER/PASS are ignored entirely in this mode.
#   third_party  -> uses SMTP_HOST/PORT/USER/PASS/SECURE as set here (SES,
#                   SendGrid, MXroute, any provider). Set MAIL_MODE=third_party
#                   and fill these in to use it.
MAIL_MODE=self_hosted
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com

# ---- Self-hosted mail server (mta service — Postfix + OpenDKIM) ----
MTA_CONTAINER_NAME=mailrova-mta
MTA_DKIM_KEYS_PATH=/mta-dkim-keys
DKIM_SELECTOR=mail
# Your server's public IP — required to generate a correct SPF record.
SERVER_PUBLIC_IP=
# Optional: a dedicated hostname for MX/receiving, e.g. mail.marketing.yourdomain.com
# (needs its own A record -> SERVER_PUBLIC_IP). Leave blank to skip inbound mail.
MTA_HOSTNAME=
# Domain bounce DSNs come back to (VERP return-path — see mta/README.md).
# Only meaningful with MAIL_MODE=self_hosted; leave blank to default to
# MTA_HOSTNAME, or blank to skip self-hosted bounce detection entirely
# (third-party MAIL_MODE bounces still work via the ESP webhooks below).
# Also needs an MX record (see the Domains page) so bounces can reach it.
BOUNCE_DOMAIN=

# ---- Media storage: "filesystem" (default, local disk/volume) or "s3" ----
# "s3" works for AWS S3 or any S3-compatible store, including Cloudflare R2 —
# for R2 set S3_ENDPOINT to https://<accountid>.r2.cloudflarestorage.com and
# S3_FORCE_PATH_STYLE=true.
MEDIA_PROVIDER=filesystem
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ---- Bounce webhooks (ESP -> POST /webhooks/bounce/<provider>) ----
# Leave blank to keep a given provider's webhook disabled. Also protects
# /webhooks/bounce/postfix (BOUNCE_DOMAIN above) — set this if using either.
BOUNCE_WEBHOOK_KEY=
BOUNCE_POSTMARK_USER=
BOUNCE_POSTMARK_PASS=
