# Copy to `.env.test` (gitignored). Tests run against a real Postgres
# database — a separate one from dev/prod, on the same `db` service, so no
# new infra. Create it once:
#
#   docker compose exec db psql -U mailrova -c "CREATE DATABASE mailrova_test"
#
# Then run the suite from inside the backend container (this project
# publishes no host port for `db`, so tests need the internal Docker
# network — same reason local browsing needs docker-compose.override.yml):
#
#   docker compose exec backend npm test
#
# tests/setup.ts truncates every table between tests — never point this at
# a database with real data.
DATABASE_URL=postgresql://mailrova:change_me@db:5432/mailrova_test?schema=public
NODE_ENV=test
JWT_SECRET=test_jwt_secret_not_for_production
PUBLIC_URL=http://localhost:5173
# Dummy values (RFC 5737 documentation-only IP) so dnsVerify.test.ts's SPF/MX
# code paths run at all — never a real, reachable server.
SERVER_PUBLIC_IP=203.0.113.10
MTA_HOSTNAME=mail.test.example
